PORT=3000
APP_BASE_URL=http://localhost:3000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=moringa
ADMIN_USERNAME=admin
ADMIN_PASSWORD="replace-with-a-strong-password"
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=owner@example.com

# Local-only email preview mode; does not send email
EMAIL_MODE=

# SMTP notification settings (required for email alerts)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional Twilio SMS / WhatsApp alert
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+15551234567
OWNER_PHONE=+15557654321
# Set to "whatsapp:+15551234567" for WhatsApp sender format when enabled
